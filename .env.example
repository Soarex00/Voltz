# Desenvolvimento: SQLite local é criado automaticamente. Node.js 22.13+.
PORT=3001
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Supabase: copie Connect > Session pooler (5432), preenchendo a senha do banco.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@POOLER_HOST:5432/postgres?sslmode=require
# Backend usa o schema privado voltz. Não precisa de chave API do Supabase.
# NODE_ENV=production
# ADMIN_EMAIL=seu-email@exemplo.com
# ADMIN_PASSWORD=uma-senha-forte-com-pelo-menos-10-caracteres

# IA: chave somente no backend. Não use prefixo VITE_ para segredos.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Frontend publicado: URL HTTPS do backend, sem /api no final.
# VITE_API_URL=https://seu-backend.onrender.com
# VITE_WHATSAPP_NUMBER=5553XXXXXXXXX
